# Nonproduction synthetic tests only. Supply secrets through the approved store.
# This file has no credentials and is not loaded automatically by the preflight.
APP_ENV=test
VERCEL_ENV=preview
PDF_PREPARATION_ENABLED=false
PDF_PREPARATION_TEST_DATA=synthetic-only

# Use the app's least-privilege runtime credential, not its migration owner.
DATABASE_URL=
# Review this binding separately. Its v1 SHA-256 covers host, port, DB and username.
PDF_PREPARATION_TEST_DATABASE_TARGET_SHA256=
# Reviewed physical UUID from public.release_database_identity after migrations.
PDF_PREPARATION_TEST_DATABASE_ID=

AUTH_REQUIRED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Dedicated private test store; scope/access must still be verified live.
BLOB_READ_WRITE_TOKEN=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
