# Core application
APP_ENV=development
# Production must use ALLOW_DEMO_ACCESS=false and AUTH_REQUIRED=true.
# Demo mode is synthetic/read-only and is not a production fallback.
ALLOW_DEMO_ACCESS=true
AUTH_REQUIRED=false

# PostgreSQL application runtime. Production URLs must use sslmode=verify-full and a
# private database with a certificate chain trusted by the runtime. Use a
# least-privilege runtime role that cannot create/alter/drop schema objects or write
# migration history.
DATABASE_URL=

# Production migrations use MIGRATION_DATABASE_URL only as a protected secret on
# the GitHub `contracttwin-production` environment. It is not an application variable:
# never add it to Vercel, a local/runtime env file, or a pulled production env file.

# Better Auth / Microsoft Entra ID
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# One-time first Admin bootstrap.
# Set to the exact Entra email of the first administrator, bootstrap once, then REMOVE this variable.
BOOTSTRAP_ADMIN_EMAIL=

# Private contract storage (Vercel Blob private store)
BLOB_READ_WRITE_TOKEN=

# Source malware scanning (private ClamAV service using INSTREAM).
# CLAMAV_HOST is required for production readiness. This client uses raw TCP;
# keep the scanner on a trusted private network, restrict access to approved runtime
# components, maintain signatures, and permit the application's 75 MiB upload limit.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Accepted range: 1000-300000 milliseconds.
CLAMAV_TIMEOUT_MS=60000

# Source-grounded contract intelligence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Scanned PDF / Office / spreadsheet layout extraction
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Durable worker lease. Default 900 seconds; accepted range 60-3600.
# Heartbeats run at one third of the lease duration, capped to 5-30 seconds.
JOB_LEASE_SECONDS=900
# Keep false during the expand-compatible worker rollout. Enable only after all
# pre-fencing worker invocations are proven drained.
JOB_LEASE_RECOVERY_ENABLED=false

# Production safety switch.
# This switch is necessary but NOT sufficient. Runtime readiness also requires:
# Entra auth + PostgreSQL + private Blob + ClamAV + OpenAI + OCR + exact current passing validation + complete governed active standards + an empty evidence-kernel blocker list.
LEGAL_RELIANCE_ENABLED=false

# Irreversible records-destruction switch. Keep false unless records management has approved purge operations.
# Even when true, the application still requires expired retention, no legal hold, and independent Admin approval.
ALLOW_SOURCE_PURGE=false

# Release pipeline only. Use independently generated high-entropy secrets.
# The first authenticates the live release-attestation endpoint; the second
# permits CI to reach a staged deployment protected by Vercel Authentication.
RELEASE_ATTESTATION_TOKEN=
VERCEL_AUTOMATION_BYPASS_SECRET=
