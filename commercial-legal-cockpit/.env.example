# Core application
APP_ENV=development
ALLOW_DEMO_ACCESS=true
AUTH_REQUIRED=false

# PostgreSQL. Use a private production database with TLS and least-privilege credentials.
DATABASE_URL=

# Better Auth / Microsoft Entra ID
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Private contract storage (Vercel Blob private store)
BLOB_READ_WRITE_TOKEN=

# Source-grounded contract intelligence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Scanned PDF / Office / spreadsheet layout extraction
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Production safety switch.
# This switch is necessary but NOT sufficient. Runtime readiness also requires:
# Entra auth + PostgreSQL + private Blob + OpenAI + OCR + current passing validation + all required active negotiation standards.
LEGAL_RELIANCE_ENABLED=false
